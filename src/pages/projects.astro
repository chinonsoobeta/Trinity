---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import site from '../data/site.json';
import projectEntries from '../data/projects.json';
import { resolveProjects } from '../lib/github.js';
const projects = await resolveProjects(projectEntries);
---
<Base current="projects" title="Projects" description={`Things ${site.name} has built.`}>
  <section class="pagehead">
    <h1>Projects</h1>
    <p>Things I've built, and what each one was for.</p>
  </section>

  {projects.length > 0 ? (
    <div class="projects-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  ) : (
    <p class="prose">Nothing here yet.</p>
  )}
</Base>
