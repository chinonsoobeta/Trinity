---
import ImagePlaceholder from './ImagePlaceholder.astro';

const { post } = Astro.props;

// UTC throughout so the date doesn't shift with the build machine's timezone.
const stamp = post.date
  ? post.date.toLocaleDateString('en-US', {
      timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric',
    })
  : '';
---
<article class="post">
  <div class="post__date">{stamp}</div>
  <div class="post__thumb">
    {post.image
      ? <img src={post.image} alt="" loading="lazy" decoding="async" />
      : <ImagePlaceholder />}
  </div>
  <div class="post__text">
    {stamp && <div class="post__stamp">{stamp}</div>}
    <a class="post__title" href={post.url} rel="noopener">
      {post.title} <span class="out" aria-hidden="true">↗</span>
    </a>
    {post.subtitle && <p class="post__sub">{post.subtitle}</p>}
  </div>
</article>
