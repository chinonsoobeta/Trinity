---
import site from '../data/site.json';

// Formspree delivers submissions to the inbox on its account, so no email
// address needs to live in this public repository.
const endpoint = site.contact.endpoint;
---
<dialog class="contact" id="contact-dialog" aria-labelledby="contact-title">
  <div class="contact__head">
    <h2 class="contact__title" id="contact-title">Get in touch</h2>
    <button type="button" class="contact__close" data-contact-close aria-label="Close">esc ✕</button>
  </div>

  <form data-contact-form action={endpoint} method="post">
    <div class="field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="contact-email">Email</label>
      <input id="contact-email" name="email" type="email" required autocomplete="email"
             placeholder="so I can reply" />
    </div>
    <div class="field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" required></textarea>
    </div>
    <input type="hidden" name="_subject" value="New message from your website" />
    <div class="hp" aria-hidden="true">
      <label for="contact-company">Company</label>
      <input id="contact-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button type="submit" class="contact__send">Send</button>
    <p class="contact__status" data-contact-status role="status"></p>
  </form>
</dialog>

<script>
  const dialog = document.getElementById('contact-dialog');
  if (dialog) {
    for (const trigger of document.querySelectorAll('[data-contact-open]')) {
      trigger.addEventListener('click', () => dialog.showModal());
    }
    dialog.querySelector('[data-contact-close]')?.addEventListener('click', () => dialog.close());

    // Clicking the darkened area closes it. The dialog's own box is inset, so a
    // click landing outside those bounds came from the backdrop.
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const box = dialog.getBoundingClientRect();
      const outside = event.clientX < box.left || event.clientX > box.right
        || event.clientY < box.top || event.clientY > box.bottom;
      if (outside) dialog.close();
    });

    const form = dialog.querySelector('[data-contact-form]');
    const status = dialog.querySelector('[data-contact-status]');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type=submit]');
      button.disabled = true;
      status.dataset.state = '';
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          // Without this the endpoint answers with a redirect to its own
          // thank-you page instead of JSON.
          headers: { accept: 'application/json' },
        });
        const payload = await res.json().catch(() => null);
        if (!res.ok) {
          throw new Error(payload?.errors?.[0]?.message || `Submission failed (${res.status})`);
        }
        status.dataset.state = 'ok';
        status.textContent = 'Sent! I’ll get back to you soon.';
        form.reset();
      } catch (err) {
        // fetch rejects with a TypeError when the network itself fails; that
        // message reads as "Failed to fetch", which means nothing to a visitor.
        const reason = err instanceof TypeError ? 'Could not reach the server' : err.message;
        status.dataset.state = 'error';
        status.textContent = `${reason}. Please try again in a moment.`;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
