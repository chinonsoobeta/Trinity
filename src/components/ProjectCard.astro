---
import ImagePlaceholder from './ImagePlaceholder.astro';

const { project, compact = false } = Astro.props;
const archived = project.status === 'archived';
// The compact card on the home page has no link row, so the image and name
// carry the link — to the live site when there is one, else the source.
const href = project.live ?? project.source ?? null;
const updated = project.updated
  ? new Date(project.updated).toLocaleDateString('en-US', {
      timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric',
    })
  : null;
---
<article class:list={['card', 'project', compact && 'project--compact']}>
  {(project.shot || !compact) && (
    <a class="project__shot" href={href ?? undefined} rel="noopener" tabindex="-1" aria-hidden="true">
      {project.shot
        ? <img src={project.shot} alt="" loading="lazy" decoding="async" />
        : <ImagePlaceholder size={compact ? 24 : 32} />}
    </a>
  )}

  <div class="project__head">
    {href
      ? <a class="project__name" href={href} rel="noopener">{project.name} <span class="out" aria-hidden="true">↗</span></a>
      : <div class="project__name">{project.name}</div>}
    {!compact && (
      <div class:list={['status', archived && 'status--archived']}>
        <span class="status__dot"></span>
        <span class="status__label">{archived ? 'archived' : 'active'}</span>
      </div>
    )}
  </div>

  <p class="project__desc">{project.description}</p>

  {project.tags?.length > 0 && (
    <div class="chips">
      {project.tags.map((tag) => <span class="chip">{tag}</span>)}
    </div>
  )}

  {updated && <div class="stamp">Updated {updated}</div>}

  {!compact && (project.live || project.source) && (
    <div class="project__links">
      {project.live && <a href={project.live} rel="noopener">live →</a>}
      {project.source && <a href={project.source} rel="noopener">source →</a>}
    </div>
  )}
</article>
